{
  "name": "@martindye/dsh-model-dial",
  "version": "1.0.0",
  "description": "Live dial for the local llama.cpp model in the DSH web app: a 34 px progress ring in the session header showing prompt processing, generation, and prompt compaction (with the summary's live percentage), fed by llama-server /slots, a tail of its log, and the DSH session log.",
  "author": "Martin Dye",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "dial",
    "progress",
    "llama.cpp",
    "llama-server",
    "monitor",
    "compaction"
  ],
  "scripts": {
    "bundle": "tsdown"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "react": "18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "@deepseek-ai/cordis",
        "react",
        "react/jsx-runtime"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martindye/dsh-model-dial.git"
  },
  "homepage": "https://github.com/martindye/dsh-model-dial#readme",
  "bugs": {
    "url": "https://github.com/martindye/dsh-model-dial/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
